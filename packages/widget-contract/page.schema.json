{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forma:page:v1",
  "title": "Декларация страницы Forma, версия 1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[a-z]{2,3}(-[a-zA-Z0-9]{2,8})*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "widgets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/widget"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "schemaVersion",
    "pageId",
    "locale",
    "title",
    "widgets"
  ],
  "additionalProperties": false,
  "$defs": {
    "layoutStep": {
      "type": "object",
      "properties": {
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end"
          ]
        }
      },
      "required": [
        "span"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "phone": {
          "$ref": "#/$defs/layoutStep"
        },
        "tablet": {
          "$ref": "#/$defs/layoutStep"
        },
        "wide": {
          "$ref": "#/$defs/layoutStep"
        }
      },
      "required": [
        "phone"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "section",
            "email"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 254
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "kind",
        "target",
        "label"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "section"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "email"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1,
                "maxLength": 254,
                "pattern": "^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
              }
            }
          }
        }
      ]
    },
    "heroProps": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "menuProps": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "priceRub": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "name",
              "priceRub"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 30
        }
      },
      "required": [
        "title",
        "items"
      ],
      "additionalProperties": false
    },
    "textProps": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "hoursProps": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "schedule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        }
      },
      "required": [
        "title",
        "schedule"
      ],
      "additionalProperties": false
    },
    "ctaProps": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "title",
        "body",
        "action"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999
        },
        "props": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "version",
        "props"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "forma.hero"
              },
              "version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/heroProps"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "forma.menu"
              },
              "version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/menuProps"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "forma.text"
              },
              "version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/textProps"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "forma.hours"
              },
              "version": {
                "const": 2
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/hoursProps"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "forma.cta"
              },
              "version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "props": {
                "$ref": "#/$defs/ctaProps"
              }
            }
          }
        }
      ]
    },
    "widget": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "required": {
          "type": "boolean"
        },
        "targets": {
          "type": "array",
          "items": {
            "enum": [
              "web",
              "ios",
              "android"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "fallback": {
          "$ref": "#/$defs/content"
        }
      },
      "required": [
        "id",
        "required",
        "targets",
        "layout",
        "content"
      ],
      "additionalProperties": false
    }
  }
}
